<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<InvariantGlobalization>true</InvariantGlobalization>
		<PublishAot>true</PublishAot>
		<RuntimeIdentifier>linux-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<IsAotCompatible>true</IsAotCompatible>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<EventSourceSupport>false</EventSourceSupport>
		<HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
		<MetadataUpdaterSupport>false</MetadataUpdaterSupport>
		<DebuggerSupport>false</DebuggerSupport>
		<UseSystemResourceKeys>true</UseSystemResourceKeys>
		<IlcGenerateDebugInfo>false</IlcGenerateDebugInfo>
		<StackTraceSupport>false</StackTraceSupport>
		<MetricsSupport>false</MetricsSupport>
		<StartupHookSupport>false</StartupHookSupport>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\src\NativePoc.Core\NativePoc.Core.csproj" />
		<ProjectReference Include="..\..\src\NativePoc.ReloadGen\NativePoc.ReloadGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all">
			<GlobalPropertiesToRemove>PublishAot;RuntimeIdentifier;SelfContained;PublishTrimmed</GlobalPropertiesToRemove>
		</ProjectReference>
	</ItemGroup>
</Project>
