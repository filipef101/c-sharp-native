<Project>
	<PropertyGroup>
		<NativePocHostDir>$(MSBuildThisFileDirectory)..\content\host\</NativePocHostDir>
	</PropertyGroup>
	<!-- Package props are imported before the app sets NativePocNav and
	     NativePocPersist, so the choice has to run as a target. -->
	<Target Name="SelectHostModules" BeforeTargets="CoreCompile">
		<ItemGroup>
			<Compile Include="$(NativePocHostDir)*.cs" />
			<Compile Remove="$(NativePocHostDir)FeedJson.cs" Condition="'$(NativePocHttp)' != 'true'" />
			<Compile Remove="$(NativePocHostDir)PersistStore.cs" Condition="'$(NativePocPersist)' != 'true'" />
			<Compile Remove="$(NativePocHostDir)NavFocus.cs" Condition="'$(NativePocNav)' != 'true'" />
		</ItemGroup>
	</Target>
	<ItemGroup>
		<AndroidResource Include="$(NativePocHostDir)Resources\**\*">
			<Link>Resources\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</AndroidResource>
	</ItemGroup>
	<Target Name="UseHostManifest" BeforeTargets="_GetAndroidPackageName">
		<Copy SourceFiles="$(NativePocHostDir)AndroidManifest.xml" DestinationFiles="$(MSBuildProjectDirectory)/obj/HostAndroidManifest.xml" />
		<PropertyGroup>
			<AndroidManifest>obj/HostAndroidManifest.xml</AndroidManifest>
		</PropertyGroup>
	</Target>
	<ItemGroup Condition="'$(NativePocDevListener)' == 'true' And '$(Configuration)' != 'Release'">
		<AndroidManifestOverlay Include="$(NativePocHostDir)Properties\DevListenerDebuggable.xml" />
	</ItemGroup>
	<ItemGroup Condition="'$(NativePocLocation)' == 'true'">
		<AndroidManifestOverlay Include="$(NativePocHostDir)Properties\LocationPermission.xml" />
	</ItemGroup>
	<PropertyGroup Condition="'$(NativePocLocation)' == 'true'">
		<!-- Same reason as the app project: the manifest merger only reruns when an
		     input such as build.props changes, and an overlay is not an input. -->
		<AndroidManifestPlaceholders>nativepocLocation=1</AndroidManifestPlaceholders>
	</PropertyGroup>
</Project>
