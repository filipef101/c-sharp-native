		<InternalsVisibleTo Include="NativePoc.Android" />
		<InternalsVisibleTo Include="CnativeApp" />
		<InternalsVisibleTo Include="NativePoc.Packing" />
		<InternalsVisibleTo Include="NativePoc.Packing.Tests" />
		<InternalsVisibleTo Include="NativePoc.iOS" />
		<InternalsVisibleTo Include="NativePoc.iOS.Contract" />
		<InternalsVisibleTo Include="NativePoc.iOS.Tests" />
		<InternalsVisibleTo Include="NativePoc.ReloadAot" />
		<InternalsVisibleTo Include="NativePoc.HotReload.Host" />
	</ItemGroup>
</Project>
