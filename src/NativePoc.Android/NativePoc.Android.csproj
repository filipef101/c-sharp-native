<Project Sdk="Microsoft.NET.Sdk" InitialTargets="RefuseDevListenerInRelease">
	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>NativePoc</RootNamespace>
		<ApplicationId>com.scratch.nativepoc</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<AcceptAndroidSDKLicenses>true</AcceptAndroidSDKLicenses>
		<IsAotCompatible>true</IsAotCompatible>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<NoWarn>$(NoWarn);IL3053</NoWarn>
		<NativePocHttp Condition="'$(NativePocHttp)' == ''">false</NativePocHttp>
		<NativePocRecycler Condition="'$(NativePocRecycler)' == ''">false</NativePocRecycler>
		<NativePocLocation Condition="'$(NativePocLocation)' == ''">false</NativePocLocation>
		<NativePocPersist Condition="'$(NativePocPersist)' == ''">false</NativePocPersist>
		<NativePocNav Condition="'$(NativePocNav)' == ''">false</NativePocNav>
		<NativePocTransition Condition="'$(NativePocTransition)' == ''">false</NativePocTransition>
		<NativePocImage Condition="'$(NativePocImage)' == ''">false</NativePocImage>
		<NativePocJni Condition="'$(NativePocJni)' == ''">false</NativePocJni>
		<NativePocShowcase Condition="'$(NativePocShowcase)' == ''">false</NativePocShowcase>
		<NativePocStress Condition="'$(NativePocStress)' == ''">false</NativePocStress>
		<NativePocWidgetFloor Condition="'$(NativePocWidgetFloor)' == ''">false</NativePocWidgetFloor>
		<NativePocHydratePrefetch Condition="'$(NativePocHydratePrefetch)' == ''">false</NativePocHydratePrefetch>
		<NativePocStartupMarks Condition="'$(NativePocStartupMarks)' == ''">false</NativePocStartupMarks>
		<NativePocDeferNatives Condition="'$(NativePocDeferNatives)' == ''">false</NativePocDeferNatives>
		<NativePocFastNatives Condition="'$(NativePocFastNatives)' == ''">false</NativePocFastNatives>
		<AndroidManifestPlaceholders>nativepocMarks=$(NativePocStartupMarks)</AndroidManifestPlaceholders>
		<WarningsNotAsErrors>XA1040</WarningsNotAsErrors>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocDevListener)' == 'true' And '$(Configuration)' != 'Release'">
		<PublishAot>true</PublishAot>
		<PublishTrimmed>true</PublishTrimmed>
		<AndroidLinkMode>SdkOnly</AndroidLinkMode>
		<TrimMode>full</TrimMode>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<NativePocProgramOnly>true</NativePocProgramOnly>
		<AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
		<IlcGenerateDebugInfo>false</IlcGenerateDebugInfo>
		<DebuggerSupport>false</DebuggerSupport>
		<InvariantGlobalization>true</InvariantGlobalization>
		<UseSystemResourceKeys>true</UseSystemResourceKeys>
		<EventSourceSupport>false</EventSourceSupport>
		<HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
		<MetadataUpdaterSupport>false</MetadataUpdaterSupport>
		<StackTraceSupport>false</StackTraceSupport>
		<MetricsSupport>false</MetricsSupport>
		<StartupHookSupport>false</StartupHookSupport>
		<_EnableSerializationDiscovery>false</_EnableSerializationDiscovery>
	</PropertyGroup>
	<ItemGroup Condition="'$(NativePocDevListener)' == 'true' And '$(Configuration)' != 'Release'">
		<AndroidManifestOverlay Include="Properties/DevListenerDebuggable.xml" />
	</ItemGroup>
	<PropertyGroup Condition="'$(NativePocProgramOnly)' == 'true'">
		<DefineConstants>$(DefineConstants);NATIVEPOC_PROGRAM_ONLY</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocHttp)' == 'true'">
		<DefineConstants>$(DefineConstants);NATIVEPOC_HTTP;NATIVEPOC_LAZY_FEED</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocRecycler)' == 'true'">
		<DefineConstants>$(DefineConstants);NATIVEPOC_RECYCLER</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocPersist)' == 'true'">
		<DefineConstants>$(DefineConstants);NATIVEPOC_PERSIST</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocNav)' == 'true'">
		<DefineConstants>$(DefineConstants);NATIVEPOC_NAV</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocTransition)' == 'true'">
		<DefineConstants>$(DefineConstants);NATIVEPOC_TRANSITION</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocImage)' == 'true'">
		<DefineConstants>$(DefineConstants);NATIVEPOC_IMAGE</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocJni)' == 'true'">
		<DefineConstants>$(DefineConstants);NATIVEPOC_JNI</DefineConstants>
	</PropertyGroup>
	<!-- The manifest merger reruns when build.props changes. An overlay is not
	     one of its inputs, so the placeholder has to be present either way. -->
	<PropertyGroup>
		<AndroidManifestPlaceholders>$(AndroidManifestPlaceholders);nativepocJni=$(NativePocJni)</AndroidManifestPlaceholders>
	</PropertyGroup>
	<ItemGroup Condition="'$(NativePocJni)' == 'true'">
		<AndroidManifestOverlay Include="Properties/VibratePermission.xml" />
	</ItemGroup>
	<PropertyGroup Condition="'$(NativePocLocation)' == 'true'">
		<DefineConstants>$(DefineConstants);NATIVEPOC_LOCATION</DefineConstants>
		<!-- The manifest merger skips when its inputs are unchanged, and an overlay
		     is not one of those inputs. A placeholder is written into build.props,
		     which is an input, so turning the module on or off remerges the manifest. -->
		<AndroidManifestPlaceholders>$(AndroidManifestPlaceholders);nativepocLocation=1</AndroidManifestPlaceholders>
	</PropertyGroup>
	<ItemGroup Condition="'$(NativePocLocation)' == 'true'">
		<AndroidManifestOverlay Include="Properties/LocationPermission.xml" />
	</ItemGroup>
	<ItemGroup Condition="'$(NativePocRecycler)' != 'true'">
		<AndroidJavaSource Remove="Java\nativepoc\KeyedList.java" />
	</ItemGroup>
	<ItemGroup>
		<ProguardConfiguration Include="proguard-jni.cfg" />
	</ItemGroup>
	<ItemGroup Condition="'$(NativePocRecycler)' == 'true'">
		<AndroidJavaSource Remove="Java\nativepoc\KeyedList.java" />
		<AndroidJavaSource Include="Java\nativepoc\KeyedList.java">
			<Bind>false</Bind>
		</AndroidJavaSource>
		<ProguardConfiguration Include="proguard-list.cfg" />
	</ItemGroup>
	<Target Name="FetchAndroidxList" BeforeTargets="_CategorizeAndroidLibraries;_ResolveLibraryProjectImports" Condition="'$(NativePocRecycler)' == 'true'">
		<PropertyGroup>
			<_AndroidxCache>$(MSBuildThisFileDirectory)..\..\tools\bench\list-floor\.cache</_AndroidxCache>
		</PropertyGroup>
		<Exec Command="bash &quot;$(MSBuildThisFileDirectory)..\..\tools\bench\fetch-androidx.sh&quot;" />
		<ItemGroup>
			<AndroidAarLibrary Include="$(_AndroidxCache)/recyclerview-1.2.1.aar" />
			<AndroidAarLibrary Include="$(_AndroidxCache)/core-1.3.2.aar" />
			<AndroidAarLibrary Include="$(_AndroidxCache)/customview-1.0.0.aar" />
			<AndroidJavaLibrary Include="$(_AndroidxCache)/collection-1.0.0.jar" />
			<AndroidJavaLibrary Include="$(_AndroidxCache)/annotation-1.1.0.jar" />
		</ItemGroup>
	</Target>
	<Target Name="DropProfileInstaller" BeforeTargets="_CategorizeAndroidLibraries;_ResolveLibraryProjectImports" Condition="'$(NativePocRecycler)' == 'true'">
		<ItemGroup>
			<AndroidAarLibrary Remove="@(AndroidAarLibrary)" Condition="$([System.String]::Copy('%(Identity)').Contains('profileinstaller')) Or $([System.String]::Copy('%(Identity)').Contains('coroutines')) Or $([System.String]::Copy('%(Identity)').Contains('tracing')) Or $([System.String]::Copy('%(Identity)').Contains('startup')) Or $([System.String]::Copy('%(Identity)').Contains('kotlin'))" />
		</ItemGroup>
	</Target>
	<Target Name="SkipAndroidXManagedBindings" BeforeTargets="GenerateBindings" Condition="'$(NativePocRecycler)' == 'true'">
		<ItemGroup>
			<AndroidAarLibrary Update="@(AndroidAarLibrary)">
				<Bind>false</Bind>
			</AndroidAarLibrary>
		</ItemGroup>
	</Target>
	<Target Name="RecyclerIsOptIn" BeforeTargets="_CategorizeAndroidLibraries;_ResolveLibraryProjectImports" Condition="'$(NativePocRecycler)' != 'true'">
		<ItemGroup>
			<AndroidAarLibrary Remove="@(AndroidAarLibrary)" Condition="$([System.String]::Copy('%(Identity)').Contains('recyclerview')) Or $([System.String]::Copy('%(Identity)').Contains('core-1.3.2')) Or $([System.String]::Copy('%(Identity)').Contains('customview-1.0.0'))" />
			<AndroidJavaLibrary Remove="@(AndroidJavaLibrary)" Condition="$([System.String]::Copy('%(Identity)').Contains('collection-1.0.0')) Or $([System.String]::Copy('%(Identity)').Contains('annotation-1.1.0'))" />
		</ItemGroup>
	</Target>
	<Target Name="NarrowRecyclerRules" BeforeTargets="_CompileToDalvik" Condition="'$(NativePocRecycler)' == 'true'">
		<Exec Command="python3 &quot;$(MSBuildThisFileDirectory)..\..\tools\bench\narrow-recycler-rules.py&quot; &quot;$(IntermediateOutputPath)&quot;" />
	</Target>
	<Target Name="FloorSkipsList" BeforeTargets="Build;Publish" Condition="'$(NativePocWidgetFloor)' == 'true' And '$(NativePocRecycler)' == 'true'">
		<Error Text="The widget floor does not carry RecyclerView." />
	</Target>
	<Target Name="RefuseRecyclerBinding" AfterTargets="ResolveAssemblyReferences" Condition="'$(NativePocRecycler)' == 'true'">
		<ItemGroup>
			<_RecyclerDll Include="@(ReferencePath)" Condition="'%(Filename)' == 'Xamarin.AndroidX.RecyclerView' Or '%(Filename)' == 'Xamarin.AndroidX.Core'" />
		</ItemGroup>
		<Error Condition="'@(_RecyclerDll)' != ''" Text="AndroidX managed bindings are referenced: @(_RecyclerDll)" />
	</Target>
	<PropertyGroup Condition="'$(NativePocHttp)' != 'true'">
		<NativePocSampleExclude>..\..\samples\feed\**</NativePocSampleExclude>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocLocation)' != 'true'">
		<NativePocSampleExclude>$(NativePocSampleExclude);..\..\samples\where\**</NativePocSampleExclude>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocHttp)' != 'true' Or '$(NativePocLocation)' != 'true'">
		<NativePocSampleExclude>$(NativePocSampleExclude);..\..\samples\visit\**</NativePocSampleExclude>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocPersist)' != 'true' Or '$(NativePocNav)' != 'true'">
		<NativePocSampleExclude>$(NativePocSampleExclude);..\..\samples\notes\**</NativePocSampleExclude>
		<NativePocSampleExclude>$(NativePocSampleExclude);..\..\samples\tasks\**</NativePocSampleExclude>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocJni)' != 'true'">
		<NativePocSampleExclude>$(NativePocSampleExclude);..\..\samples\bind\**</NativePocSampleExclude>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocStress)' == 'true'">
		<NativePocShowcase>true</NativePocShowcase>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocShowcase)' != 'true'">
		<NativePocSampleExclude>$(NativePocSampleExclude);..\..\samples\showcase\**</NativePocSampleExclude>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocShowcase)' == 'true' And '$(NativePocWidgetFloor)' != 'true'">
		<ApplicationId>com.scratch.nativepoc.showcase</ApplicationId>
		<NativePocImage>true</NativePocImage>
		<NativePocRecycler>true</NativePocRecycler>
		<DefineConstants>$(DefineConstants);NATIVEPOC_ROOT_HOME;NATIVEPOC_IMAGE;NATIVEPOC_RECYCLER</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocStress)' == 'true'">
		<ApplicationId>com.scratch.nativepoc.stress</ApplicationId>
	</PropertyGroup>
	<ItemGroup Condition="'$(NativePocShowcase)' == 'true' And '$(NativePocWidgetFloor)' != 'true'">
		<AndroidJavaSource Remove="Java\nativepoc\KeyedList.java" />
		<AndroidJavaSource Include="Java\nativepoc\KeyedList.java">
			<Bind>false</Bind>
		</AndroidJavaSource>
		<ProguardConfiguration Remove="proguard-list.cfg" />
		<ProguardConfiguration Include="proguard-list.cfg" />
	</ItemGroup>
	<Target Name="WriteShelfGlazes" Condition="'$(NativePocImage)' == 'true'"
		Inputs="$(MSBuildThisFileDirectory)..\..\tools\glaze\GlazeWrite.cs;$(MSBuildThisFileDirectory)..\..\tools\glaze\JpegEncode.cs;$(MSBuildThisFileDirectory)..\..\tools\glaze\GlazeWrite.csproj"
		Outputs="$(IntermediateOutputPath)shelf-glaze\Resources\drawable\shelf_harbor.jpg">
		<PropertyGroup>
			<_GlazeDir>$(IntermediateOutputPath)shelf-glaze\Resources\drawable\</_GlazeDir>
			<_GlazeProject>$(MSBuildThisFileDirectory)..\..\tools\glaze\GlazeWrite.csproj</_GlazeProject>
			<_GlazeDll>$(MSBuildThisFileDirectory)..\..\tools\glaze\bin\Release\net10.0\GlazeWrite.dll</_GlazeDll>
		</PropertyGroup>
		<MakeDir Directories="$(_GlazeDir)" />
		<Exec Command="dotnet build &quot;$(_GlazeProject)&quot; -c Release -nodeReuse:false --nologo -v q" EnvironmentVariables="MSBUILDDISABLENODEREUSE=1" />
		<Exec Command="dotnet exec &quot;$(_GlazeDll)&quot; &quot;$(_GlazeDir)&quot;" />
	</Target>
	<Target Name="IncludeShelfGlazes" BeforeTargets="_ComputeAndroidResourcePaths" DependsOnTargets="WriteShelfGlazes" Condition="'$(NativePocImage)' == 'true'">
		<ItemGroup>
			<AndroidResource Include="$(IntermediateOutputPath)shelf-glaze\Resources\drawable\shelf_*.jpg" />
		</ItemGroup>
	</Target>
	<!-- Same showcase compile, an empty column, and a second package so the
	     bench can install it beside Northroom. -->
	<PropertyGroup Condition="'$(NativePocWidgetFloor)' == 'true'">
		<ApplicationId>com.scratch.nativepoc.widgetfloor</ApplicationId>
		<NativePocRecycler>false</NativePocRecycler>
		<NativePocImage>false</NativePocImage>
		<DefineConstants>$(DefineConstants);NATIVEPOC_WIDGET_FLOOR</DefineConstants>
	</PropertyGroup>
	<!-- Same Northroom screens with chrome on the first frame, and a third
	     package so the bench can install it beside the deferred showcase. -->
	<PropertyGroup Condition="'$(NativePocImmediateChrome)' == 'true' And '$(NativePocWidgetFloor)' != 'true'">
		<ApplicationId>com.scratch.nativepoc.immediate</ApplicationId>
		<DefineConstants>$(DefineConstants);NATIVEPOC_IMMEDIATE_CHROME</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocBlankChrome)' == 'true' And '$(NativePocWidgetFloor)' != 'true' And '$(NativePocImmediateChrome)' != 'true'">
		<ApplicationId>com.scratch.nativepoc.blank</ApplicationId>
		<DefineConstants>$(DefineConstants);NATIVEPOC_BLANK_CHROME</DefineConstants>
	</PropertyGroup>
	<Target Name="RefuseDevListenerInRelease" BeforeTargets="Build;Publish">
		<Error
			Condition="'$(NativePocDevListener)' == 'true' And '$(Configuration)' == 'Release'"
			Text="NativePocDevListener refuses to build into a normal Release." />
		<Error
			Condition="'$(NativePocDevListener)' != 'true' And '$(Configuration)' != 'Release' And '$(PublishAot)' == 'true'"
			Text="PublishAot on a Debug build requires NativePocDevListener, which keeps the program-only listener. A normal Release publishes NativeAOT without the listener." />
	</Target>
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<PublishAot>true</PublishAot>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<InvariantGlobalization>true</InvariantGlobalization>
		<EventSourceSupport>false</EventSourceSupport>
		<HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
		<MetadataUpdaterSupport>false</MetadataUpdaterSupport>
		<DebuggerSupport>false</DebuggerSupport>
		<UseSystemResourceKeys>true</UseSystemResourceKeys>
		<!-- Portable sequence points stay out of the APK. ILC -g writes them into
		     NativePoc.Android.so.dbg, and strip removes .debug_* from the shipped .so.
		     AndroidIncludeDebugSymbols stays false, so the runtime type map does not change. -->
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<NativeDebugSymbols>true</NativeDebugSymbols>
		<IlcGenerateDebugInfo>true</IlcGenerateDebugInfo>
		<StackTraceSupport>true</StackTraceSupport>
		<!-- The interleaved n=12 repeat=4 pair put dehydration back on.
		     Evidence is in scroll-floor.txt. -->
		<AndroidLinkTool>r8</AndroidLinkTool>
		<IlcDehydrate>true</IlcDehydrate>
		<IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
		<MetricsSupport>false</MetricsSupport>
		<StartupHookSupport>false</StartupHookSupport>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(PublishAot)' != 'true'">
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>partial</TrimMode>
		<RunAOTCompilation>true</RunAOTCompilation>
	</PropertyGroup>
	<ItemGroup>
		<Using Include="NativePoc" />
		<Compile Include="..\..\samples\*\*.cs" Exclude="..\..\samples\NativePoc.*\**;**\bin\**;**\obj\**;$(NativePocSampleExclude)" />
		<Compile Remove="..\..\samples\showcase\StressScreen.cs" Condition="'$(NativePocStress)' != 'true'" />
		<Compile Remove="FeedJson.cs" Condition="'$(NativePocHttp)' != 'true'" />
		<Compile Remove="PersistStore.cs" Condition="'$(NativePocPersist)' != 'true'" />
		<Compile Remove="NavFocus.cs" Condition="'$(NativePocNav)' != 'true'" />
		<Compile Remove="NavTransition.cs" Condition="'$(NativePocTransition)' != 'true'" />
		<Compile Remove="ImageModule.cs" Condition="'$(NativePocImage)' != 'true'" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\NativePoc.Core\NativePoc.Core.csproj" />
		<ProjectReference Include="..\NativePoc.Screen\NativePoc.Screen.csproj" />
		<ProjectReference Include="..\..\samples\NativePoc.Packing\NativePoc.Packing.csproj" />
		<ProjectReference Include="..\..\samples\NativePoc.Library\NativePoc.Library.csproj" />
		<ProjectReference Include="..\NativePoc.ReloadGen\NativePoc.ReloadGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\NativePoc.ReloadGen.CodeFixes\NativePoc.ReloadGen.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" Condition="'$(DesignTimeBuild)' == 'true'" />
	</ItemGroup>
	<PropertyGroup Condition="'$(NativePocStartupMarks)' == 'true'">
		<DefineConstants>$(DefineConstants);NATIVEPOC_STARTUP_MARKS</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocFastNatives)' == 'true'">
		<DefineConstants>$(DefineConstants);NATIVEPOC_FAST_NATIVES</DefineConstants>
	</PropertyGroup>
	<ItemGroup Condition="'$(NativePocFastNatives)' != 'true'">
		<AndroidJavaSource Remove="Java\nativepoc\ActivityNatives.java" />
	</ItemGroup>
	<ItemGroup Condition="'$(NativePocFastNatives)' == 'true'">
		<AndroidJavaSource Remove="Java\nativepoc\ActivityNatives.java" />
		<AndroidJavaSource Include="Java\nativepoc\ActivityNatives.java">
			<Bind>false</Bind>
		</AndroidJavaSource>
	</ItemGroup>
	<ItemGroup Condition="'$(NativePocStartupMarks)' != 'true'">
		<AndroidJavaSource Remove="Java\nativepoc\StartupProbe.java" />
		<AndroidJavaSource Remove="Java\nativepoc\StartupApp.java" />
		<AndroidJavaSource Remove="Java\nativepoc\ThinActivity.java" />
	</ItemGroup>
	<ItemGroup Condition="'$(NativePocStartupMarks)' == 'true'">
		<AndroidJavaSource Remove="Java\nativepoc\StartupProbe.java" />
		<AndroidJavaSource Include="Java\nativepoc\StartupProbe.java">
			<Bind>false</Bind>
		</AndroidJavaSource>
		<AndroidJavaSource Remove="Java\nativepoc\StartupApp.java" />
		<AndroidJavaSource Include="Java\nativepoc\StartupApp.java">
			<Bind>false</Bind>
		</AndroidJavaSource>
		<AndroidJavaSource Remove="Java\nativepoc\ThinActivity.java" />
		<AndroidJavaSource Include="Java\nativepoc\ThinActivity.java">
			<Bind>false</Bind>
		</AndroidJavaSource>
		<AndroidManifestOverlay Include="Properties\StartupMarks.xml" />
	</ItemGroup>
	<PropertyGroup Condition="'$(NativePocStartupTune)' == 'true' And '$(Configuration)' == 'Release'">
		<OptimizationPreference>Speed</OptimizationPreference>
		<IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
		<ServerGarbageCollection>false</ServerGarbageCollection>
		<ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
	</PropertyGroup>
	<ItemGroup Condition="'$(NativePocStartupTune)' == 'true' And '$(Configuration)' == 'Release'">
		<RuntimeHostConfigurationOption Include="System.GC.Server" Value="false" />
		<RuntimeHostConfigurationOption Include="System.GC.Concurrent" Value="false" />
		<RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="0" />
		<AndroidEnvironment Include="Properties\startup-gc.env" />
	</ItemGroup>
	<ItemGroup Condition="'$(NativePocAotProfile)' != ''">
		<AndroidAotProfile Include="$(NativePocAotProfile)" />
	</ItemGroup>
	<!-- DebugSymbols emits the portable pdb. The Android NativeAOT targets turn
	     StripSymbols off when that property is set, which would ship the debug
	     sections. Put them back before the link, and keep the pdb for ILC only. -->
	<Target Name="KeepSequencePointsForDbg" AfterTargets="_PrepareLinking" BeforeTargets="LinkNative" Condition="'$(Configuration)' == 'Release'">
		<PropertyGroup>
			<TrimmerRemoveSymbols>false</TrimmerRemoveSymbols>
			<StripSymbols>true</StripSymbols>
			<NativeDebugSymbols>true</NativeDebugSymbols>
		</PropertyGroup>
	</Target>
	<Target Name="CompileLoadMark" BeforeTargets="LinkNative" DependsOnTargets="_AndroidBeforeIlcCompile" Condition="'$(NativePocStartupMarks)' == 'true' And '$(Configuration)' == 'Release'">
		<PropertyGroup>
			<_LoadMarkApi>$([System.String]::Copy('$(SupportedOSPlatformVersion)').Split('.')[0])</_LoadMarkApi>
			<_LoadMarkClang>$(_AndroidNdkDirectory)toolchains/llvm/prebuilt/$(_NdkPrebuiltAbi)/bin/$(_NdkAbi)-linux-android$(_LoadMarkApi)-clang</_LoadMarkClang>
			<_LoadMarkObj>$(IntermediateOutputPath)loadmark.o</_LoadMarkObj>
		</PropertyGroup>
		<Error Condition="!Exists('$(_LoadMarkClang)')" Text="Load mark clang was not found at $(_LoadMarkClang)." />
		<PropertyGroup>
			<_LoadMarkExtra Condition="'$(NativePocHydratePrefetch)' == 'true'">-DNATIVEPOC_HYDRATE_PREFETCH=1</_LoadMarkExtra>
		</PropertyGroup>
		<Exec Command="&quot;$(_LoadMarkClang)&quot; -fPIC -Os $(_LoadMarkExtra) -c &quot;$(MSBuildThisFileDirectory)native/loadmark.c&quot; -o &quot;$(_LoadMarkObj)&quot;" />
		<Exec Command="python3 &quot;$(MSBuildThisFileDirectory)native/export-thin.py&quot; &quot;$(IntermediateOutputPath)native/$(AssemblyName).exports&quot;" />
		<ItemGroup>
			<LinkerArg Include="&quot;$(_LoadMarkObj)&quot;" />
			<LinkerArg Include="-llog" />
		</ItemGroup>
	</Target>
	<!-- The generated wrapper is overwritten by _GenerateJavaStubs, which
	     _CompileJava depends on. Mark it after the stub exists. -->
	<Target Name="MarkJcwActivity" BeforeTargets="_CompileJava" Condition="'$(NativePocStartupMarks)' == 'true'">
		<ItemGroup>
			<_JcwActivity Include="$(IntermediateOutputPath)android/src/**/MainActivity.java" />
		</ItemGroup>
		<Exec Command="python3 &quot;$(MSBuildThisFileDirectory)native/mark-jcw.py&quot; &quot;%(_JcwActivity.Identity)&quot;" />
	</Target>
	<!-- After the mark patch, when that target ran. Registers onCreate only. -->
	<Target Name="DeferActivityNatives" BeforeTargets="_CompileJava" DependsOnTargets="MarkJcwActivity" Condition="'$(NativePocDeferNatives)' == 'true'">
		<ItemGroup>
			<_DeferActivity Include="$(IntermediateOutputPath)android/src/**/MainActivity.java" />
		</ItemGroup>
		<Exec Command="python3 &quot;$(MSBuildThisFileDirectory)native/defer-natives.py&quot; &quot;%(_DeferActivity.Identity)&quot;" />
	</Target>
	<Target Name="RefuseFastAndDefer" BeforeTargets="MarkJcwActivity" Condition="'$(NativePocFastNatives)' == 'true' And '$(NativePocDeferNatives)' == 'true'">
		<Error Text="NativePocFastNatives and NativePocDeferNatives cannot both be set." />
	</Target>
	<!-- After the mark patch, when that target ran. One RegisterNatives table. -->
	<Target Name="FastActivityNatives" BeforeTargets="_CompileJava" DependsOnTargets="MarkJcwActivity" Condition="'$(NativePocFastNatives)' == 'true'">
		<ItemGroup>
			<_FastActivity Include="$(IntermediateOutputPath)android/src/**/MainActivity.java" />
		</ItemGroup>
		<Exec Command="python3 &quot;$(MSBuildThisFileDirectory)native/fast-natives.py&quot; &quot;%(_FastActivity.Identity)&quot;" />
	</Target>
	<Target Name="ExportFastNatives" BeforeTargets="LinkNative" DependsOnTargets="_AndroidBeforeIlcCompile" Condition="'$(NativePocFastNatives)' == 'true' And '$(Configuration)' == 'Release'">
		<Exec Command="python3 &quot;$(MSBuildThisFileDirectory)native/export-fast.py&quot; &quot;$(IntermediateOutputPath)native/$(AssemblyName).exports&quot;" />
	</Target>
	<ItemGroup Condition="'$(NativePocPackRelocs)' != ''">
		<LinkerArg Include="-Wl,--pack-dyn-relocs=$(NativePocPackRelocs)" />
	</ItemGroup>
	<ItemGroup Condition="'$(NativePocVersionScript)' != ''">
		<LinkerArg Include="-Wl,--version-script=$(NativePocVersionScript)" />
	</ItemGroup>
	<ItemGroup Condition="'$(NativePocSymbolOrder)' != ''">
		<LinkerArg Include="-Wl,--symbol-ordering-file=$(NativePocSymbolOrder)" />
	</ItemGroup>
	<ItemGroup Condition="'$(NativePocEmbedSo)' == 'true'">
		<AndroidManifestOverlay Include="Properties\EmbedSo.xml" />
	</ItemGroup>
	<!-- The merger inputs do not include the overlay item, so an incremental
	     publish would keep the previous extractNativeLibs value. -->
	<Target Name="RefreshEmbedManifest" BeforeTargets="_ManifestMerger">
		<Delete Files="$(IntermediateOutputPath)android/AndroidManifest.xml" Condition="Exists('$(IntermediateOutputPath)android/AndroidManifest.xml')" />
	</Target>
	<Target Name="DropPdbFromPackage" AfterTargets="ILLink" Condition="'$(Configuration)' == 'Release'">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
			<_LinkedResolvedFileToPublish Remove="@(_LinkedResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
		</ItemGroup>
	</Target>
</Project>
