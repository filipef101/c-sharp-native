<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<NoWarn>CS8524</NoWarn>
		<RootNamespace>NativePoc.Devx</RootNamespace>
		<AssemblyName>cnative</AssemblyName>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\NativePoc.HotReload.Host\NativePoc.HotReload.Host.csproj" />
		<InternalsVisibleTo Include="NativePoc.Devx.Cli.Tests" />
	</ItemGroup>
</Project>
