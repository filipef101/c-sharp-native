<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<NoWarn>CS8524</NoWarn>
		<RootNamespace>NativePoc.Devx</RootNamespace>
		<AssemblyName>cnative</AssemblyName>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>
	<ItemGroup>
		<Reference Include="Microsoft.CodeAnalysis">
			<HintPath>$(NetCoreRoot)sdk/$(NETCoreSdkVersion)/Microsoft.CodeAnalysis.dll</HintPath>
			<Private>true</Private>
		</Reference>
		<Reference Include="Microsoft.CodeAnalysis.CSharp">
			<HintPath>$(NetCoreRoot)sdk/$(NETCoreSdkVersion)/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
			<Private>true</Private>
		</Reference>
		<InternalsVisibleTo Include="NativePoc.Devx.Cli.Tests" />
	</ItemGroup>
</Project>
