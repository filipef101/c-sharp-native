<Project Sdk="Microsoft.NET.Sdk" InitialTargets="RefuseDevListenerInRelease">
	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>NativePoc</RootNamespace>
		<AssemblyName>CnativeApp</AssemblyName>
		<ApplicationId>com.scratch.nativepoc</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<AcceptAndroidSDKLicenses>true</AcceptAndroidSDKLicenses>
		<IsAotCompatible>true</IsAotCompatible>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<NoWarn>$(NoWarn);IL3053</NoWarn>
		<NativePocHttp Condition="'$(NativePocHttp)' == ''">false</NativePocHttp>
		<NativePocRecycler Condition="'$(NativePocRecycler)' == ''">false</NativePocRecycler>
		<NativePocLocation Condition="'$(NativePocLocation)' == ''">false</NativePocLocation>
		<NativePocNav>CNATIVE_NAV</NativePocNav>
		<NativePocTransition Condition="'$(NativePocTransition)' == ''">false</NativePocTransition>
		<NativePocImage Condition="'$(NativePocImage)' == ''">false</NativePocImage>
		<NativePocJni Condition="'$(NativePocJni)' == ''">false</NativePocJni>
		<NativePocPersist>CNATIVE_PERSIST</NativePocPersist>
		<DefineConstants>$(DefineConstants);NATIVEPOC_ROOT_HOME</DefineConstants>
		<WarningsNotAsErrors>XA1040</WarningsNotAsErrors>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocDevListener)' == 'true' And '$(Configuration)' != 'Release'">
		<PublishAot>true</PublishAot>
		<PublishTrimmed>true</PublishTrimmed>
		<AndroidLinkMode>SdkOnly</AndroidLinkMode>
		<TrimMode>full</TrimMode>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<NativePocProgramOnly>true</NativePocProgramOnly>
		<AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
		<IlcGenerateDebugInfo>false</IlcGenerateDebugInfo>
		<DebuggerSupport>false</DebuggerSupport>
		<InvariantGlobalization>true</InvariantGlobalization>
		<UseSystemResourceKeys>true</UseSystemResourceKeys>
		<EventSourceSupport>false</EventSourceSupport>
		<HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
		<MetadataUpdaterSupport>false</MetadataUpdaterSupport>
		<StackTraceSupport>false</StackTraceSupport>
		<MetricsSupport>false</MetricsSupport>
		<StartupHookSupport>false</StartupHookSupport>
		<_EnableSerializationDiscovery>false</_EnableSerializationDiscovery>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocProgramOnly)' == 'true'">
		<DefineConstants>$(DefineConstants);NATIVEPOC_PROGRAM_ONLY</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocHttp)' == 'true'">
		<DefineConstants>$(DefineConstants);NATIVEPOC_HTTP;NATIVEPOC_LAZY_FEED</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocLocation)' == 'true'">
		<DefineConstants>$(DefineConstants);NATIVEPOC_LOCATION</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocNav)' == 'true'">
		<DefineConstants>$(DefineConstants);NATIVEPOC_NAV</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocTransition)' == 'true'">
		<DefineConstants>$(DefineConstants);NATIVEPOC_TRANSITION</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocImage)' == 'true'">
		<DefineConstants>$(DefineConstants);NATIVEPOC_IMAGE</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocJni)' == 'true'">
		<DefineConstants>$(DefineConstants);NATIVEPOC_JNI</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(NativePocPersist)' == 'true'">
		<DefineConstants>$(DefineConstants);NATIVEPOC_PERSIST</DefineConstants>
	</PropertyGroup>
	<Target Name="RefuseDevListenerInRelease" BeforeTargets="Build;Publish">
		<Error
			Condition="'$(NativePocDevListener)' == 'true' And '$(Configuration)' == 'Release'"
			Text="NativePocDevListener refuses to build into a normal Release." />
		<Error
			Condition="'$(NativePocDevListener)' != 'true' And '$(Configuration)' != 'Release' And '$(PublishAot)' == 'true'"
			Text="PublishAot on a Debug build requires NativePocDevListener, which keeps the program-only listener. A normal Release publishes NativeAOT without the listener." />
	</Target>
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<PublishAot>true</PublishAot>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<InvariantGlobalization>true</InvariantGlobalization>
		<EventSourceSupport>false</EventSourceSupport>
		<HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
		<MetadataUpdaterSupport>false</MetadataUpdaterSupport>
		<DebuggerSupport>false</DebuggerSupport>
		<UseSystemResourceKeys>true</UseSystemResourceKeys>
		<IlcGenerateDebugInfo>false</IlcGenerateDebugInfo>
		<StackTraceSupport>false</StackTraceSupport>
		<MetricsSupport>false</MetricsSupport>
		<StartupHookSupport>false</StartupHookSupport>
	</PropertyGroup>
	<ItemGroup>
		<Using Include="NativePoc" />
		<PackageReference Include="NativePoc.Core" Version="0.3.0" />
		<PackageReference Include="NativePoc.Screen" Version="0.3.0" />
		<PackageReference Include="NativePoc.Packing" Version="0.3.0" />
		<PackageReference Include="NativePoc.Library" Version="0.3.0" />
		<PackageReference Include="NativePoc.ReloadGen" Version="0.3.0" />
		<PackageReference Include="NativePoc.Host" Version="0.3.0" />
	</ItemGroup>
	<!-- ILC's input is the trimmed dll, which ILLink rewrites on every publish,
	     so an unchanged second publish still compiles. Hash the sources, the
	     restored package assets, and the publish flags instead, and touch the
	     native outputs when that hash matches. -->
	<Target Name="PrepareIlcStamp" BeforeTargets="_RunILLink;IlcCompile" Condition="'$(PublishAot)' == 'true'">
		<MakeDir Directories="$(NativeIntermediateOutputPath)" />
		<ItemGroup>
			<_IlcStampInput Include="$(MSBuildProjectDirectory)\screens\**\*.cs" />
			<_IlcStampInput Include="$(MSBuildProjectDirectory)\*.cs" />
			<_IlcStampInput Include="$(MSBuildProjectFile)" />
			<_IlcStampInput Include="$(MSBuildProjectDirectory)\nuget.config" Condition="Exists('$(MSBuildProjectDirectory)\nuget.config')" />
			<_IlcStampInput Include="$(ProjectAssetsFile)" Condition="'$(ProjectAssetsFile)' != '' And Exists('$(ProjectAssetsFile)')" />
		</ItemGroup>
		<PropertyGroup>
			<_IlcStampFlags>$(Configuration)|$(RuntimeIdentifier)|$(TargetFramework)|$(NativePocDevListener)|$(NativePocProgramOnly)|$(DefineConstants)|$(IlcToolsPath)|$(TrimMode)|$(AndroidLinkMode)</_IlcStampFlags>
			<_IlcStampFile>$(NativeIntermediateOutputPath)ilc-inputs.sha256</_IlcStampFile>
			<_IlcStampList>$(NativeIntermediateOutputPath)ilc-stamp-inputs.txt</_IlcStampList>
			<_IlcStampFlagFile>$(NativeIntermediateOutputPath)ilc-stamp-flags.txt</_IlcStampFlagFile>
		</PropertyGroup>
		<WriteLinesToFile File="$(_IlcStampList)" Lines="@(_IlcStampInput)" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<WriteLinesToFile File="$(_IlcStampFlagFile)" Lines="$(_IlcStampFlags)" Overwrite="true" WriteOnlyWhenDifferent="true" />
	</Target>
	<Target Name="SkipTrimWhenIlcInputsMatch" BeforeTargets="_RunILLink" Condition="'$(PublishAot)' == 'true' And Exists('$(NativeObject)') And Exists('$(_LinkSemaphore)')">
		<Exec Command="sh &quot;$(MSBuildProjectDirectory)/build/ilc-stamp.sh&quot; check &quot;$(_IlcStampFile)&quot; &quot;$(_IlcStampFlagFile)&quot; &quot;$(_IlcStampList)&quot; &quot;$(_LinkSemaphore)&quot;" />
	</Target>
	<Target Name="SkipIlcWhenInputsMatch" BeforeTargets="IlcCompile" Condition="'$(PublishAot)' == 'true' And Exists('$(NativeObject)')">
		<Exec Command="sh &quot;$(MSBuildProjectDirectory)/build/ilc-stamp.sh&quot; check &quot;$(_IlcStampFile)&quot; &quot;$(_IlcStampFlagFile)&quot; &quot;$(_IlcStampList)&quot; &quot;$(NativeObject)&quot; &quot;$(NativeBinary)&quot;" />
	</Target>
	<Target Name="WriteIlcInputStamp" AfterTargets="IlcCompile" Condition="'$(PublishAot)' == 'true'">
		<Exec Command="sh &quot;$(MSBuildProjectDirectory)/build/ilc-stamp.sh&quot; write &quot;$(_IlcStampFile)&quot; &quot;$(_IlcStampFlagFile)&quot; &quot;$(_IlcStampList)&quot;" />
	</Target>
	<Target Name="RefreshPublishApk" AfterTargets="_CreateUniversalApkFromBundle" Condition="'$(PublishDir)' != '' And Exists('$(OutDir)$(_AndroidPackage)-Signed.apk')">
		<Copy SourceFiles="$(OutDir)$(_AndroidPackage)-Signed.apk" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
	</Target>
</Project>
