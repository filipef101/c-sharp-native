{
  "$schema": "http://json.schemastore.org/template",
  "author": "Native PoC",
  "classifications": ["Android", "NativeAOT"],
  "identity": "NativePoc.CnativeApp",
  "name": "Native PoC app",
  "shortName": "cnative-app",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "cnativeapp",
  "preferNameDirectory": true,
  "symbols": {
    "feed": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "CNATIVE_FEED",
      "defaultValue": "packages",
      "description": "Absolute path of the local NativePoc package folder."
    },
    "nav": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Compile the navigation stack into the app."
    },
    "persist": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Compile the file persist store into the app."
    },
    "navFlag": {
      "type": "generated",
      "generator": "switch",
      "replaces": "CNATIVE_NAV",
      "parameters": {
        "evaluator": "C++2",
        "datatype": "string",
        "cases": [
          { "condition": "(nav)", "value": "true" },
          { "condition": "(!nav)", "value": "false" }
        ]
      }
    },
    "persistFlag": {
      "type": "generated",
      "generator": "switch",
      "replaces": "CNATIVE_PERSIST",
      "parameters": {
        "evaluator": "C++2",
        "datatype": "string",
        "cases": [
          { "condition": "(persist)", "value": "true" },
          { "condition": "(!persist)", "value": "false" }
        ]
      }
    }
  }
}
